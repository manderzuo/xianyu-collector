# BRAND_NAME 占位，域名待你补充
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=xianyu_rewrite
MYSQL_USER=xianyu
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
BACKEND_WEB_PORT=28089
WEBSOCKET_PORT=28090
SCHEDULER_PORT=28091
CARD_DOCK_BASE_URL=
EXTERNAL_API_KEY=
FRONTEND_PORT=20000
CORS_ORIGINS=http://127.0.0.1:20000,http://localhost:20000
BACKEND_WEB_PUBLIC_URL=
FRONTEND_PUBLIC_URL=
XIANYU_CLOUD_AUTH_URL=https://www.gemstory.cn
XIANYU_ALLOW_INSECURE_CLOUD_AUTH=false
XIANYU_CLOUD_AUTH_MAX_ATTEMPTS=5
XIANYU_CLOUD_AUTH_CONNECT_TIMEOUT=20
XIANYU_CLOUD_AUTH_READ_TIMEOUT=60
XIANYU_CLOUD_AUTH_WRITE_TIMEOUT=30
XIANYU_CLOUD_AUTH_POOL_TIMEOUT=20
XIANYU_CLOUD_AUTH_RETRY_BACKOFF=2
XIANYU_CLOUD_AUTH_MAX_RETRY_BACKOFF=10
JWT_SECRET=replace-with-a-long-random-jwt-secret
BRAND_NAME=BRAND_NAME
BRAND_DOMAIN=
BOOTSTRAP_ADMIN_PASSWORD=
XR_CONTAINER_PREFIX=xianyu-app
XR_NETWORK_NAME=xianyu-app-net
XR_VOLUME_PREFIX=xianyu-app
COMPOSE_PROJECT_NAME=xianyu-app
XR_DEPLOY_MODE=local
XR_IMAGE_REGISTRY=ghcr.io
XR_IMAGE_NAMESPACE=manderzuo/xianyu-collector
XR_IMAGE_TAG=local
UPDATE_CHECK_ON_START=true
UPDATE_MANIFEST_URL=https://www.gemstory.cn/release/xianyu/latest.json
UPDATE_MANIFEST_TOKEN=
UPDATE_ALLOW_INSECURE_HTTP=false
# Set to true in commercial packages after deploy/update-signing-public-key.xml
# has been installed. The public key is safe to distribute; never distribute
# the private signing key.
UPDATE_REQUIRE_SIGNATURE=false
UPDATE_MANIFEST_PUBLIC_KEY_PATH=deploy/update-signing-public-key.xml
UPDATE_MANIFEST_SIGNATURE_URL=https://www.gemstory.cn/release/xianyu/latest.json.sig
